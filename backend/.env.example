# Configuración del Servidor HTTP
PORT=8080
GIN_MODE=debug

# Configuración de Base de Datos PostgreSQL 15+
DB_HOST=localhost
DB_PORT=5432
DB_USER=bloodlink
DB_PASSWORD=bloodlink_secret_2026
DB_NAME=bloodlink_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME_MIN=30

# Seguridad: JWT (HS256) y Cifrado Simétrico AES-256-GCM (32 bytes = 64 caracteres hex)
JWT_SECRET=bloodlink_minsa_jwt_secret_key_2026_peru_red_nacional
JWT_EXPIRATION_HOURS=8
AES_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Interoperabilidad y CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
SOAP_ENDPOINT_URL=http://localhost:8080/soap/v1/interoperabilidad
